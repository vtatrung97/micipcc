SERVER_PORT=8090
MANAGEMENT_PORT=8091
ENABLE_SWAGGER=true
# Nhiều domain cách nhau bởi dấu phẩy, đặt trong nháy kép; hỗ trợ pattern VD https://*.viettel.vn
CORS_ALLOWED_ORIGINS="http://localhost:4200,http://192.168.10.18:4200"

# MariaDB (schema integration_service)
# Giá trị có ký tự # phải đặt trong nháy kép, nếu không IntelliJ/dotenv hiểu phần sau # là comment
DATASOURCE_URL=jdbc:mariadb://localhost:3307/integration_service
DATASOURCE_USERNAME=integration_service
DATASOURCE_PASSWORD="integration_service#123"
DATASOURCE_POOL_SIZE=20
# Flyway (db/migration): mặc định dùng user datasource (cần quyền DDL trên integration_service, xem db/database_setup.sql)
FLYWAY_ENABLED=true
# FLYWAY_USERNAME=
# FLYWAY_PASSWORD=

# Redis: standalone hoặc Sentinel (REDIS_SENTINEL=true)
REDIS_SENTINEL=false
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_MASTER_NAME=mymaster
REDIS_SENTINEL_NODES=redis-sentinel-0:26379,redis-sentinel-1:26379,redis-sentinel-2:26379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_DATABASE=0
REDIS_KEY_PREFIX=ticket-flow:integration:
# Redis-backed Spring Cache
CACHE_ENABLED=true
CACHE_DEFAULT_TTL=10m

KEYCLOAK_AUTH_SERVER_URL=http://192.168.10.24:8081

MINIO_BASE_URL=http://192.168.10.27:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=

# Key nội bộ dùng chung mọi service: serviceName:key, cách nhau bởi dấu phẩy, key >= 32 ký tự. Gọi sang service X gửi X-API-Key = key của X; service chỉ nhận key mang tên mình
# Sinh key: openssl rand -hex 32
INTERNAL_API_KEYS=core-service:change-me-core0123456789abcdef0123456789,engine-service:change-me-engine0123456789abcdef01234567,integration-service:change-me-0123456789abcdef0123456789,report-service:change-me-abcdef0123456789abcdef012345

# Master key mã hoá secret của connection (bảng connection_credential), AES-256-GCM: base64 của 32 byte.
# BẮT BUỘC, không có giá trị mặc định: thiếu thì service không start. Mỗi môi trường (DEV/UAT/PROD) một key riêng,
# đặt trong K8s Secret, không commit. Mất key = mất toàn bộ secret đã lưu. Sinh key: openssl rand -base64 32
# Giá trị dưới CHỈ dùng cho local.
CREDENTIAL_MASTER_KEY=nG8OnVQxXVAWa3bQtwBMMJo5P0culN0kA+g3sldSxvM=
