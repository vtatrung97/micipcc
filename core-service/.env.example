SERVER_PORT=8080
MANAGEMENT_PORT=8081
ENABLE_SWAGGER=true
# false: tắt xác thực, mọi API public (tạm thời khi chưa có Keycloak)
SECURITY_ENABLED=false
# Nhiều domain cách nhau bởi dấu phẩy, đặt trong nháy kép; hỗ trợ pattern VD https://*.viettel.vn
CORS_ALLOWED_ORIGINS="http://localhost:4200,http://192.168.10.18:4200"

# MariaDB (schema flow_core)
# Giá trị có ký tự # phải đặt trong nháy kép, nếu không IntelliJ/dotenv hiểu phần sau # là comment
DATASOURCE_URL=jdbc:mariadb://localhost:3307/flow_core
DATASOURCE_USERNAME=flow_core
DATASOURCE_PASSWORD="flow_core#123"
DATASOURCE_POOL_SIZE=20

# Redis: standalone hoặc Sentinel (REDIS_SENTINEL=true)
REDIS_SENTINEL=false
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_MASTER_NAME=mymaster
REDIS_SENTINEL_NODES=redis-sentinel-0:26379,redis-sentinel-1:26379,redis-sentinel-2:26379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_DATABASE=0
REDIS_KEY_PREFIX=processx:core:

# Keycloak (dùng chung với IPCC 2.0)
KEYCLOAK_AUTH_SERVER_URL=http://localhost:8180
KEYCLOAK_REALM=ipcc
KEYCLOAK_CLIENT_ID=processx-core
KEYCLOAK_CLIENT_SECRET=
KEYCLOAK_ROLE_CLIENTS=processx-web,processx-core
KEYCLOAK_POOL_SIZE=50

# Keycloak Admin Client (đọc user/group/role). Mặc định dùng service account của KEYCLOAK_CLIENT_ID (client_credentials)
KEYCLOAK_ADMIN_ENABLED=false
KEYCLOAK_ADMIN_AUTH_SERVER_URL=
KEYCLOAK_ADMIN_REALM=
KEYCLOAK_ADMIN_CLIENT_ID=processx-core
KEYCLOAK_ADMIN_CLIENT_SECRET=
# Chỉ điền khi bắt buộc đăng nhập bằng tài khoản admin (realm master, client admin-cli)
KEYCLOAK_ADMIN_USERNAME=
KEYCLOAK_ADMIN_PASSWORD=

# API key cho service nội bộ: clientId:key, cách nhau bởi dấu phẩy, key >= 32 ký tự
# Sinh key: openssl rand -hex 32
INTERNAL_API_KEYS=integration-service:change-me-0123456789abcdef0123456789,report-service:change-me-abcdef0123456789abcdef012345
