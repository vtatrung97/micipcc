SERVER_PORT=8080
ENABLE_SWAGGER=true
# Nhiều domain cách nhau bởi dấu phẩy, đặt trong nháy kép; hỗ trợ pattern VD https://*.viettel.vn
CORS_ALLOWED_ORIGINS="http://localhost:4200,http://192.168.10.18:4200"

# MariaDB (schema flow_core)
# Giá trị có ký tự # phải đặt trong nháy kép, nếu không IntelliJ/dotenv hiểu phần sau # là comment
DATASOURCE_URL=jdbc:mariadb://localhost:3307/flow_core
DATASOURCE_USERNAME=flow_core
DATASOURCE_PASSWORD="flow_core#123"
DATASOURCE_POOL_SIZE=20
# Flyway (db/migration): mặc định dùng user datasource (cần quyền DDL trên flow_core, xem db/database_setup.sql)
FLYWAY_ENABLED=true
# FLYWAY_USERNAME=
# FLYWAY_PASSWORD=

# Redis: standalone hoặc Sentinel (REDIS_SENTINEL=true)
REDIS_SENTINEL=false
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_MASTER_NAME=mymaster
REDIS_SENTINEL_NODES=redis-sentinel-0:26379,redis-sentinel-1:26379,redis-sentinel-2:26379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_DATABASE=0
REDIS_KEY_PREFIX=ticket-flow:core:
# Redis-backed Spring Cache
CACHE_ENABLED=true
CACHE_DEFAULT_TTL=10m

# Keycloak: chỉ dùng để xác thực JWT (tải public key của realm), không cần tài khoản admin/client secret
# URL gốc Keycloak, VD https://sso.example.vn
KEYCLOAK_AUTH_SERVER_URL=http://localhost:8180

# Realm cấp token cho người dùng (phần sau /realms/ trong claim iss của token)
KEYCLOAK_REALM=ticket-flow

# Giá trị bắt buộc có trong claim aud của token
KEYCLOAK_AUDIENCE=ticket-flow-api

# Các client lấy client role từ resource_access của token, cách nhau bởi dấu phẩy
KEYCLOAK_ROLE_CLIENTS=ticket-flow-web,ticket-flow-core

# Tuỳ chọn: chỉ đặt khi URL Keycloak trong token (iss) khác URL BE gọi được (VD public domain vs nội bộ k8s)
# KEYCLOAK_ISSUER_URI=https://sso.example.vn/realms/ticket-flow
# KEYCLOAK_JWK_SET_URI=http://keycloak.internal:8080/realms/ticket-flow/protocol/openid-connect/certs

# API key cho service nội bộ: clientId:key, cách nhau bởi dấu phẩy, key >= 32 ký tự
# Sinh key: openssl rand -hex 32
INTERNAL_API_KEYS=integration-service:change-me-0123456789abcdef0123456789,report-service:change-me-abcdef0123456789abcdef012345
