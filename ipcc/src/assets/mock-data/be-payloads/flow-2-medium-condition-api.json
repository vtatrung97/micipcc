        "type": "condition",
        "gatewayType": "exclusive",
        "label": "Kiểm tra hạn mức cước",
        "category": "condition",
        "config": {
          "logicOperator": "AND",
          "conditionVariable": "flow.variables.dispute_amount",
          "branches": [
            {
              "id": "branch-auto-refund",
              "name": "Nhánh 1: Cước <= 200,000 VNĐ (Tự động)",
              "defaultLabel": "Nhánh 1",
              "value": "LE_200K",
              "expression": "flow.variables.dispute_amount <= 200000",
              "isDefault": false,
              "rules": [
                {
                  "param": "flow.variables.dispute_amount",
                  "operator": "Nhỏ hơn hoặc bằng (<=)",
                  "value": "200000"
                }
              ]
            },
            {
              "id": "branch-manual-approval",
              "name": "Nhánh 2: Mặc định (> 200,000 VNĐ)",
              "defaultLabel": "Mặc định",
              "value": "GT_200K",
              "expression": "default",
              "isDefault": true,
              "rules": []
            }
          ],
          "defaultFlowOutput": "branch-manual-approval",
          "errorFlowOutput": "flow-error-fallback",
          "description": "Rẽ 1 nhánh duy nhất: Cước nhỏ tự động hoàn; Cước lớn cần phê duyệt"
        }
      },
