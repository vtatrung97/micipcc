        "id": "node-act-refund",
        "nodeKey": "ACT_CORE_REFUND",
        "type": "action",
        "label": "Tác vụ hoàn cước API",
        "category": "general",
        "config": {
          "actionSource": "custom",
          "integratedSystem": "BILLING_CORE_BSS",
          "selectedApi": "POST /api/v2/invoices/reverse-charge",
          "actionMethod": "POST",
          "actionEndpoint": "https://billing-core.viettel.vn/api/v2/invoices/reverse-charge",
          "timeoutSeconds": 5,
          "slaSeconds": 5,
          "retryCount": 3,
          "retryInterval": "2s",
          "circuitBreakerTimeoutMs": 5000,
          "requestBodyMapping": "{\n  \"subscriberId\": \"${flow.variables.sub_id}\",\n  \"amount\": ${flow.variables.dispute_amount},\n  \"reasonCode\": \"DISPUTE_APPROVED\",\n  \"ticketId\": \"${flow.variables.ticket_id}\"\n}",
          "responseMapping": "flow.variables.refund_transaction_id = response.data.transactionId;\nflow.variables.refund_status = response.data.status;",
          "apiOutput": "output_refund_result",
          "description": "Gọi Rest API sang hệ thống tính cước BSS để thực hiện điều chỉnh hóa đơn"
        }
