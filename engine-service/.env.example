SERVER_PORT=8002
MANAGEMENT_PORT=9000
ENABLE_SWAGGER=true

DATASOURCE_URL=jdbc:mariadb://localhost:3307/engine_service
DATASOURCE_USERNAME=engine_service
DATASOURCE_PASSWORD="change-me"
DATASOURCE_POOL_SIZE=20
DATASOURCE_MIN_IDLE=5

# Local development only. Keep false in production.
FLOWABLE_DATABASE_SCHEMA_UPDATE=true
FLOWABLE_ASYNC_EXECUTOR_ACTIVATE=true
FLOWABLE_HISTORY_LEVEL=audit

# Redis (common-core luôn tạo kết nối, engine không dùng cache)
REDIS_HOST=localhost
REDIS_PORT=6379

KEYCLOAK_AUTH_SERVER_URL=http://192.168.10.24:8081
MINIO_BASE_URL=http://192.168.10.27:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=

# Key nội bộ dùng chung mọi service: serviceName:key, cách nhau bởi dấu phẩy, key >= 32 ký tự.
# engine nhận key "engine-service", gửi key "integration-service" khi gọi integration-service.
INTERNAL_API_KEYS=core-service:change-me-core0123456789abcdef0123456789,engine-service:change-me-engine0123456789abcdef01234567,integration-service:change-me-0123456789abcdef0123456789,report-service:change-me-abcdef0123456789abcdef012345

# http = gọi integration-service thật; stub = giả lập thành công (khi integration-service chưa có API)
INTEGRATION_MODE=stub
INTEGRATION_BASE_URL=http://localhost:8090
